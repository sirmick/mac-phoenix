# Build
build*/
toolchain/
*.o
*.a
*.so
*.dylib

# Packaging artifacts
/dist/
/packaging/build-ctx/
/debian/cargo-home/
/debian/.debhelper/
/debian/files
/debian/*.substvars
/debian/mac-phoenix/
/debian/debhelper-build-stamp
/debian/tmp/
/net-bridge/.cargo/config.toml
/net-bridge/vendor/cargo/

# Debug and validation logs
*.log
*.diff

# Runtime state
config.json
BasiliskII_XPRAM
.basilisk_ii_xpram
BasiliskII_Prefs
basilisk_ii.prefs

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node.js / Playwright
node_modules/
test-results/
playwright-report/

# Python
__pycache__/
*.pyc
*.iso
*$py.class

# Apple Universal Interfaces (licensed, not redistributable)
Universal Interfaces/
.finf/
.rsrc/

# Retro68 BridgeAgent build artifacts (BridgeAgent.bin is checked in)
BridgeAgent/BridgeAgent.APPL
BridgeAgent/BridgeAgent.dsk
BridgeAgent/BridgeAgent.code.bin
BridgeAgent/BridgeAgent.code.bin.gdb

# Retro68 MacBrowser build artifacts (MacBrowser.bin is checked in)
MacBrowser/MacBrowser.APPL
MacBrowser/MacBrowser.dsk
MacBrowser/MacBrowser.code.bin
MacBrowser/MacBrowser.code.bin.gdb

# Rust
net-bridge/target/
# Vendored legacy OpenSSL build tree — regenerate via
# net-bridge/tools/build-legacy-openssl.sh (needed for --mitm-tls).
net-bridge/vendor/

# MITM TLS root CA — default dir when --mitm-ca-dir isn't set.
# Contains a private key; must never be committed.
.mitm_ca/
build_output.txt
build_stdout.txt
build_warnings.txt

# Local scratch
private/

# Perf-record raw data (SVG/.folded/run_log are small; .data is ~60MB each)
docs/ppc/late-*-artifacts/perf/*.data

# Generated by tools/png2icn.py at build time from tools/icons/*.png
MacBrowser/icons.r
BridgeAgent/icons.r
