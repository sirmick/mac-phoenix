net-bridge/vendor/

# MITM TLS root CA — default dir when --mitm-ca-dir isn't set.
# Contains a private key; must never be committed.
.mitm_ca/
build_output.txt
build_stdout.txt
build_warnings.txt

# Local scratch
private/

# Perf-record raw data (SVG/.folded/run_log are small; .data is ~60MB each)
docs/ppc/late-*-artifacts/perf/*.data
