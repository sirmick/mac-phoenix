# build.mpw — DevTest on StdCLib's device table; tools/mpw/mpw build tests/guest/devtest
# products: DevTest
Delete -i DevTest
MrC devtest.c -o devtest.o
PPCLink -main __start devtest.o ∂
	"{SharedLibraries}InterfaceLib" "{SharedLibraries}StdCLib" ∂
	"{PPCLibraries}StdCRuntime.o" "{PPCLibraries}PPCCRuntime.o" ∂
	-t APPL -c 'DvTs' -o DevTest
Rez -a devtest.r -o DevTest
SetFile -t APPL -c 'DvTs' -a B DevTest
