# Executor's tab as a user service:
#   cp tools/web/server/executor-web.service ~/.config/systemd/user/
#   cp tools/web/server/server.example.toml ~/.config/executor-web/server.toml   (and edit)
#   python3 tools/web/server --config ~/.config/executor-web/server.toml adduser NAME --owner
#   systemctl --user enable --now executor-web
# (loginctl enable-linger USER to keep it running signed out.)
[Unit]
Description=Executor in a browser tab (tools/web/server)
After=network.target

[Service]
ExecStart=/usr/bin/python3 %h/src/mac-phoenix/tools/web/server --config %h/.config/executor-web/server.toml --quiet
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
