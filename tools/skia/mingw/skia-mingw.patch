--- a/gn/BUILDCONFIG.gn
+++ b/gn/BUILDCONFIG.gn
@@ -71,6 +71,15 @@ is_mac = current_os == "mac"
 is_wasm = current_os == "wasm"
 is_win = current_os == "win"
 
+# mingw-w64 (gcc or clang, e.g. llvm-mingw's x86_64-w64-mingw32-clang++)
+# rather than MSVC/clang-cl: Windows sources, GCC-style flags and toolchain
+is_mingw = is_win && filter_include([ cxx ],
+                                    [
+                                      "*g++",
+                                      "*clang++",
+                                    ]) != []
+is_msvc = is_win && !is_mingw
+
 # Dawn has references to fuchsia, but Skia's GN rules do not
 is_fuchsia = false
 
