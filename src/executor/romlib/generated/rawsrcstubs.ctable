  { const uint32_t s = CL_RAW ((CL_RAW (src[1]) << left_shift) | (CL_RAW (src[2]) >> right_shift)); uint32_t d = dst[1] & ~s; d |= (s & bk_bits); dst[1] = d; }
notand_shift_fgbk_many_6:
  { const uint32_t s = CL_RAW ((CL_RAW (src[2]) << left_shift) | (CL_RAW (src[3]) >> right_shift)); uint32_t d = dst[2] & ~s; d |= (s & bk_bits); dst[2] = d; }
notand_shift_fgbk_many_5:
  { const uint32_t s = CL_RAW ((CL_RAW (src[3]) << left_shift) | (CL_RAW (src[4]) >> right_shift)); uint32_t d = dst[3] & ~s; d |= (s & bk_bits); dst[3] = d; }
notand_shift_fgbk_many_4:
  { const uint32_t s = CL_RAW ((CL_RAW (src[4]) << left_shift) | (CL_RAW (src[5]) >> right_shift)); uint32_t d = dst[4] & ~s; d |= (s & bk_bits); dst[4] = d; }
notand_shift_fgbk_many_3:
  { const uint32_t s = CL_RAW ((CL_RAW (src[5]) << left_shift) | (CL_RAW (src[6]) >> right_shift)); uint32_t d = dst[5] & ~s; d |= (s & bk_bits); dst[5] = d; }
notand_shift_fgbk_many_2:
  { const uint32_t s = CL_RAW ((CL_RAW (src[6]) << left_shift) | (CL_RAW (src[7]) >> right_shift)); uint32_t d = dst[6] & ~s; d |= (s & bk_bits); dst[6] = d; }
notand_shift_fgbk_many_1:
  { const uint32_t s = CL_RAW ((CL_RAW (src[7]) << left_shift) | (CL_RAW (src[8]) >> right_shift)); uint32_t d = dst[7] & ~s; d |= (s & bk_bits); dst[7] = d; }
#if defined (i386)
src += 8; /* Avoids AGI stall here. */
  dst += 8; /* Avoids AGI stall here. */
#endif
  if ((arg -= 8) > 0)
    goto notand_shift_fgbk_many_loop;
  JUMP_TO_NEXT;
 done:
  src_row_base += srcblt_src_row_stride;
  dst_row_base += srcblt_dst_row_stride;
  } while (--num_rows > 0);
  return labels;  /* Let gcc know labels are used. */
}
