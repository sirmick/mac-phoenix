# Dockerfile.retro68 — builds the Retro68 cross-compiler toolchain ONCE.
#
# Output image: mac-phoenix:retro68
#   /opt/retro68/bin/m68k-apple-macos-{gcc,g++,as,ld,...}
#   /opt/retro68/bin/Rez
#   /opt/retro68/m68k-apple-macos/{CIncludes,RIncludes,...}
#
# Other Dockerfiles (Dockerfile.deb, Dockerfile.rpm) consume this image
# via `COPY --from=mac-phoenix:retro68 /opt/retro68 /opt/retro68` so the
# 30-minute toolchain build only runs once.
#
# Why Ubuntu 22.04 (oldest distro we target): the resulting binaries link
# against glibc, and binaries built on a newer glibc fail with
# "GLIBC_2.39 not found" on older systems. Building on the oldest target
# gives us forward compatibility with all other targets in the matrix.
#
# Built by packaging/run_matrix.sh on first invocation, after which docker
# layer caching makes it a no-op until you `docker rmi mac-phoenix:retro68`.

FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        ca-certificates \
        bison \
        flex \
        ruby \
        texinfo \
        libgmp-dev \
        libmpfr-dev \
        libmpc-dev \
        libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Pin to a known-good Retro68 commit. Bumping this is fine but the image
# tag should be invalidated (`docker rmi mac-phoenix:retro68`) so the
# rebuild actually picks up new code.
RUN git clone --recursive https://github.com/autc04/Retro68.git Retro68-src \
 && mkdir Retro68-build \
 && cd Retro68-build \
 && ../Retro68-src/build-toolchain.bash --no-carbon \
 && mv toolchain /opt/retro68 \
 && rm -rf /build/Retro68-src /build/Retro68-build

# Sanity check
RUN /opt/retro68/bin/m68k-apple-macos-gcc --version | head -1

# This image isn't meant to be run; it's only consumed via COPY --from.
CMD ["echo", "This image is a build artifact source for COPY --from=mac-phoenix:retro68"]
