# Dockerfile.deb — builds a .deb from the source tarball and installs it
# into a clean stage to verify the layout. Boot tests mount ~/storage at
# runtime (see packaging/run_matrix.sh).
#
# Build context (set up by run_matrix.sh):
#   ./mac-phoenix_<ver>.tar.xz
#
# BridgeAgent.bin / MacBrowser.bin are shipped as committed artifacts;
# package builds set BUILD_BRIDGE_AGENT=OFF + BUILD_MAC_BROWSER=OFF so
# they don't need Retro68. Maintainers rebuild via packaging/Dockerfile.dev.
#
# Build-deps come from `apt-get build-dep .` reading debian/control —
# single source of truth shared with the GH Actions workflow. To change
# build-deps, edit debian/control only.
#
# Usage:
#   docker build -f packaging/Dockerfile.deb \
#     --build-arg BASE=ubuntu:24.04 \
#     -t mac-phoenix-pkg:ubuntu-24.04 \
#     packaging/build-ctx

ARG BASE=ubuntu:24.04

# ---------- build stage ---------------------------------------------------
FROM ${BASE} AS build
ARG DEBIAN_FRONTEND=noninteractive

WORKDIR /src

# xz-utils is needed before we can extract the tarball; everything else
# (build-essential, dpkg-dev, debhelper, build-dep .) needs debian/control
# which lives inside the tarball, so happens after extraction.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY mac-phoenix_*.tar.xz /tmp/source.tar.xz
RUN tar -xJf /tmp/source.tar.xz --strip-components=1 -C /src

# Now that debian/control is on disk, pull the full build-dep set.
# Single source of truth shared with .github/workflows/build.yml.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        debhelper \
        devscripts \
        dpkg-dev \
        curl \
    && apt-get build-dep -y . \
    && rm -rf /var/lib/apt/lists/*

# Cargo.toml pins rust-version = 1.75. Ubuntu 24.04 (apt rustc 1.75) and
# Fedora 40 (1.78) are fine; older distros need a rustup fallback.
ENV RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH
RUN APT_RUSTC="$(rustc --version | awk '{print $2}')"; \
    APT_MAJOR="$(echo "$APT_RUSTC" | cut -d. -f1)"; \
    APT_MINOR="$(echo "$APT_RUSTC" | cut -d. -f2)"; \
    if [ "$APT_MAJOR" -gt 1 ] || { [ "$APT_MAJOR" -eq 1 ] && [ "$APT_MINOR" -ge 75 ]; }; then \
        echo "apt rustc $APT_RUSTC >= 1.75 — skipping rustup"; \
    else \
        echo "apt rustc $APT_RUSTC < 1.75 — installing via rustup"; \
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
            | CARGO_HOME=/usr/local/cargo sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path; \
    fi \
 && rustc --version

RUN dpkg-buildpackage -us -uc -b \
 && mkdir -p /pkg && cp /*.deb /pkg/

# ---------- test stage (clean image, no build deps) -----------------------
FROM ${BASE} AS test
ARG DEBIAN_FRONTEND=noninteractive

COPY --from=build /pkg/*.deb /pkg/

RUN apt-get update && apt-get install -y --no-install-recommends \
        /pkg/*.deb \
        ca-certificates \
        curl \
        jq \
        hfsutils \
    && rm -rf /var/lib/apt/lists/*

# Layout smoke test — fails the image build if anything's misplaced.
COPY --from=build /src/packaging/ci/smoke-installed.sh /smoke-installed.sh
RUN /smoke-installed.sh

# Default cmd kept generic so run_matrix.sh can override with a boot test.
CMD ["mac-phoenix", "--help"]
