diff --git a/qemu/target/m68k/translate.c b/qemu/target/m68k/translate.c
index 8f94004..84b9c67 100644
--- a/qemu/target/m68k/translate.c
+++ b/qemu/target/m68k/translate.c
@@ -1528,6 +1528,16 @@ static void gen_exit_tb(DisasContext *s)
 
 static inline bool use_goto_tb(DisasContext *s, uint32_t dest)
 {
+    /* Allow goto_tb for ALL branches (including backward/loops).
+     *
+     * Previously disabled for backward branches because hook_block
+     * was needed for timer polling and interrupt delivery. Now:
+     * - Interrupts auto-ack in m68k_cpu_exec_interrupt (no hook_block ack needed)
+     * - Timer polling still uses hook_block every 4096 blocks, but interrupt
+     *   delivery via uc_emu_stop() uses cpu_exit() which sets exit_request,
+     *   checked at each TB entry via gen_tb_start's icount_decr test.
+     * - goto_tb chains break when exit_request is set, so interrupts
+     *   are still delivered promptly even in tight loops. */
     return (s->base.pc_first & TARGET_PAGE_MASK) == (dest & TARGET_PAGE_MASK)
         || (s->base.pc_next & TARGET_PAGE_MASK) == (dest & TARGET_PAGE_MASK);
 }
@@ -1536,6 +1546,17 @@ static inline bool use_goto_tb(DisasContext *s, uint32_t dest)
 static void gen_jmp_tb(DisasContext *s, int n, uint32_t dest)
 {
     TCGContext *tcg_ctx = s->uc->tcg_ctx;
+    /* Sync cc_op to env->cc_op before leaving this TB.
+     * When cc_op is known at compile time (not CC_OP_DYNAMIC), write it
+     * so the target TB can read it correctly at runtime.
+     * We bypass update_cc_op()'s cc_op_synced tracking because
+     * gen_jmpcc calls gen_jmp_tb twice (taken/not-taken) and the
+     * synced flag from the first call would suppress the second.
+     * When cc_op IS CC_OP_DYNAMIC, env->cc_op already holds the
+     * correct runtime value and must not be overwritten with 0.  */
+    if (s->cc_op != CC_OP_DYNAMIC) {
+        tcg_gen_movi_i32(tcg_ctx, QREG_CC_OP, s->cc_op);
+    }
     if (unlikely(s->base.singlestep_enabled)) {
         gen_exception(s, dest, EXCP_DEBUG);
     } else if (use_goto_tb(s, dest)) {
@@ -1580,6 +1601,7 @@ DISAS_INSN(dbcc)
     reg = DREG(insn, 0);
     base = s->pc;
     offset = (int16_t)read_im16(env, s);
+
     l1 = gen_new_label(tcg_ctx);
     gen_jmpcc(s, (insn >> 8) & 0xf, l1);
 
@@ -1588,7 +1610,9 @@ DISAS_INSN(dbcc)
     tcg_gen_addi_i32(tcg_ctx, tmp, tmp, -1);
     gen_partset_reg(tcg_ctx, OS_WORD, reg, tmp);
     tcg_gen_brcondi_i32(tcg_ctx, TCG_COND_EQ, tmp, -1, l1);
+
     gen_jmp_tb(s, 1, base + offset);
+
     gen_set_label(tcg_ctx, l1);
     gen_jmp_tb(s, 0, s->pc);
 }
@@ -1598,6 +1622,23 @@ DISAS_INSN(undef_mac)
     gen_exception(s, s->base.pc_next, EXCP_LINEA);
 }
 
+/* EmulOp handler for A-line opcodes 0xAE00-0xAE3F */
+DISAS_INSN(emulop_aline)
+{
+    /* For now, generate A-line exception so our hook can handle it.
+     * This validates that we're intercepting the right opcodes.
+     *
+     * Future: Will add helper to handle EmulOps directly without exceptions.
+     * TCGContext *tcg_ctx = s->uc->tcg_ctx;
+     * uint16_t emulop_num = insn & 0x3F;
+     * uint16_t legacy_opcode = 0x7100 | emulop_num;
+     * TCGv_i32 op = tcg_const_i32(tcg_ctx, legacy_opcode);
+     * gen_helper_emulop(tcg_ctx, tcg_ctx->cpu_env, op);
+     * tcg_temp_free_i32(tcg_ctx, op);
+     */
+    gen_exception(s, s->base.pc_next, EXCP_LINEA);
+}
+
 DISAS_INSN(undef_fpu)
 {
     gen_exception(s, s->base.pc_next, EXCP_LINEF);
@@ -3174,6 +3215,7 @@ DISAS_INSN(branch)
     } else if (offset == -1) {
         offset = read_im32(env, s);
     }
+
     if (op == 1) {
         /* bsr */
         gen_push(s, tcg_const_i32(tcg_ctx, s->pc));
@@ -6198,6 +6240,9 @@ void register_m68k_insns (CPUM68KState *env)
     INSN(suba,      91c0, f1c0, CF_ISA_A);
     INSN(suba,      90c0, f0c0, M68000);
 
+    /* Register EmulOp handler for 0xAE00-0xAE3F BEFORE generic A-line handler */
+    INSN(emulop_aline, ae00, ffc0, M68000);  /* 0xAE00-0xAE3F: EmulOps */
+
     BASE(undef_mac, a000, f000);
     INSN(mac,       a000, f100, CF_EMAC);
     INSN(from_mac,  a180, f9b0, CF_EMAC);
@@ -6475,6 +6520,7 @@ void restore_state_to_opc(CPUM68KState *env, TranslationBlock *tb,
 {
     int cc_op = data[1];
     env->pc = data[0];
+
     if (cc_op != CC_OP_DYNAMIC) {
         env->cc_op = cc_op;
     }
diff --git a/qemu/target/m68k/unicorn.c b/qemu/target/m68k/unicorn.c
index 42ef1ff..b2d053c 100644
--- a/qemu/target/m68k/unicorn.c
+++ b/qemu/target/m68k/unicorn.c
@@ -49,6 +49,23 @@ static void reg_reset(struct uc_struct *uc)
     env->pc = 0;
 }
 
+/* Trigger M68K hardware interrupt using QEMU's native mechanism
+ * This is exported for use by macemu-next to trigger timer interrupts.
+ * Uses the same code path as QEMU's Quadra 800 platform (hw/m68k/q800.c).
+ */
+DEFAULT_VISIBILITY
+void uc_m68k_trigger_interrupt(struct uc_struct *uc, int level, uint8_t vector)
+{
+    if (!uc || !uc->cpu) {
+        fprintf(stderr, "[ERROR] uc_m68k_trigger_interrupt: NULL pointer! uc=%p, uc->cpu=%p\n",
+                (void*)uc, uc ? (void*)uc->cpu : NULL);
+        return;
+    }
+
+    M68kCPU *cpu = (M68kCPU *)uc->cpu;
+    m68k_set_irq_level(cpu, level, vector);
+}
+
 DEFAULT_VISIBILITY
 uc_err reg_read(void *_env, int mode, unsigned int regid, void *value,
                 size_t *size)
@@ -72,7 +89,11 @@ uc_err reg_read(void *_env, int mode, unsigned int regid, void *value,
             break;
         case UC_M68K_REG_SR:
             CHECK_REG_TYPE(uint32_t);
-            env->cc_op = CC_OP_FLAGS;
+            // cpu_m68k_get_sr() calls cpu_m68k_get_ccr() which handles all
+            // cc_op types non-destructively using local variables.
+            // Do NOT call helper_flush_flags() here - it destructively sets
+            // env->cc_op = CC_OP_FLAGS, corrupting lazy CC state that
+            // subsequent JIT translation blocks depend on.
             *(uint32_t *)value = cpu_m68k_get_sr(env);
             break;
         case UC_M68K_REG_CR_SFC:
