--- a/qemu/accel/tcg/cpu-exec.c
+++ b/qemu/accel/tcg/cpu-exec.c
@@ -29,6 +29,9 @@
 #include "sysemu/cpus.h"
 #include "uc_priv.h"
 
+/* Global CHECKLOAD counter - set by macemu-next, read here */
+volatile int g_cpu_exec_checkload_count = 0;
+
 /* -icount align implementation. */
 
 typedef struct SyncClocks {
@@ -244,6 +247,11 @@ static inline void tb_add_jump(TranslationBlock *tb, int n,
     return;
 }
 
+/* TB lookup/compile counters — accessed from unicorn_wrapper.c */
+uint64_t g_tb_find_count = 0;
+uint64_t g_tb_miss_count = 0;
+uint64_t g_tb_buffer_flush_count = 0;
+
 static inline TranslationBlock *tb_find(CPUState *cpu,
                                         TranslationBlock *last_tb,
                                         int tb_exit, uint32_t cf_mask)
@@ -256,8 +264,10 @@ static inline TranslationBlock *tb_find(CPUState *cpu,
     struct list_item *cur;
     struct hook *hook;
 
+    g_tb_find_count++;
     tb = tb_lookup__cpu_state(cpu, &pc, &cs_base, &flags, cf_mask);
     if (tb == NULL) {
+        g_tb_miss_count++;
         mmap_lock();
         tb = tb_gen_code(cpu, pc, cs_base, flags, cf_mask);
         mmap_unlock();
@@ -402,6 +412,41 @@ static inline bool cpu_handle_exception(CPUState *cpu, int *ret)
         CPUPPCState *env = &(POWERPC_CPU(uc->cpu)->env);
         env->nip += 4;
 #endif
+#if defined(TARGET_M68K)
+        /* M68K: Handle RTE (Return from Exception) by calling QEMU's native handler.
+         * EXCP_RTE (0x100) needs special handling because m68k_interrupt_all() must
+         * be called to update PC from stack. If we don't do this here, exception_index
+         * gets cleared (line 426) before m68k_interrupt_all() is ever called, causing
+         * an infinite RTE loop with batch execution.
+         */
+        if (cpu->exception_index == 0x100) {  /* EXCP_RTE */
+            CPUM68KState *env = &(M68K_CPU(uc->cpu)->env);
+            m68k_interrupt_all(env, 0);  /* is_hw=0 for software exception */
+            cpu->exception_index = -1;
+            *ret = EXCP_INTERRUPT;
+            return false;
+        }
+#endif
+
+#if defined(TARGET_M68K)
+        /* For M68K A-line exceptions: Read the opcode BEFORE calling hooks
+         * because the hook will advance PC, making it impossible to check afterward */
+        uint16_t m68k_aline_opcode = 0;
+        bool m68k_is_aline = (cpu->exception_index == 10);
+        bool m68k_is_emulop = false;
+
+        if (m68k_is_aline) {
+            CPUM68KState *env = &(M68K_CPU(uc->cpu)->env);
+            uint8_t opcode_bytes[2];
+            cpu_memory_rw_debug(env_cpu(env), env->pc, opcode_bytes, 2, 0);
+            m68k_aline_opcode = (opcode_bytes[0] << 8) | opcode_bytes[1];
+            m68k_is_emulop = ((m68k_aline_opcode & 0xFFC0) == 0xAE00);
+
+            /* (diagnostics stripped for performance) */
+        }
+        /* (exception counter stripped for performance) */
+#endif
+
         // Unicorn: call registered interrupt callbacks
         catched = false;
         HOOK_FOREACH_VAR_DECLARE;
@@ -412,6 +457,22 @@ static inline bool cpu_handle_exception(CPUState *cpu, int *ret)
             JIT_CALLBACK_GUARD(((uc_cb_hookintr_t)hook->callback)(uc, cpu->exception_index, hook->user_data));
             catched = true;
         }
+
+#if defined(TARGET_M68K)
+        /* Handle A-line traps based on what we determined BEFORE the hook ran */
+        if (m68k_is_aline) {
+            if (m68k_is_emulop) {
+                /* EmulOp - hook already handled it */
+                catched = true;
+            } else {
+                /* Non-EmulOp A-line trap - use proper exception handling */
+                CPUM68KState *env = &(M68K_CPU(uc->cpu)->env);
+                m68k_interrupt_all(env, 0);
+                catched = true;
+            }
+        }
+#endif
+
         // Unicorn: If un-catched interrupt, stop executions.
         if (!catched) {
             // printf("AAAAAAAAAAAA\n"); qq
