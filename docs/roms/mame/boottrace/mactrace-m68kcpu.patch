+/* ---- MacPhoenix boot tracer (docs/roms/mame): MACTRACE=<file> --------
+   Logs, in execution order, the first execution of every PC (ROM: 'R',
+   elsewhere: 'M'), with the previous PC, instruction count and cycles;
+   A-line traps ('A': every one up to MACTRACE_TRAPS, then only first
+   per trap word); bus errors ('B'). Only the first CPU that runs uses it. */
+namespace {
+struct mactrace_t {
+	int enabled = -1;
+	FILE *f = nullptr;
+	const void *owner = nullptr;
+	std::vector<uint8_t> hit;      // bit per (region<<24|a24)
+	std::vector<uint32_t> trapcnt;
+	uint64_t icount = 0, trapseq = 0, trapmax = 20000, becount = 0;
+	uint32_t lastpc = 0;
+	std::vector<std::pair<uint32_t, std::string>> snaps;   // a24 -> name
+	std::string base;
+	~mactrace_t() { finish(); }
+	void finish() {
+		if (!f) return;
+		for (unsigned i = 0; i < trapcnt.size(); i++)
+			if (trapcnt[i]) fprintf(f, "T\t%04x\t%u\n", 0xa000 | i, trapcnt[i]);
+		fprintf(f, "E\t%llu\n", (unsigned long long)icount);
+		fclose(f); f = nullptr;
+	}
+	bool init(const void *who, uint32_t clk) {
+		const char *p = getenv("MACTRACE");
+		if (!p) { enabled = 0; return false; }
+		f = fopen(p, "w");
+		if (!f) { enabled = 0; return false; }
+		setvbuf(f, nullptr, _IOFBF, 1 << 20);
+		if (const char *t = getenv("MACTRACE_TRAPS")) trapmax = strtoull(t, nullptr, 0);
+		hit.assign((size_t(17) << 24) / 8, 0);
+		trapcnt.assign(0x1000, 0);
+		owner = who;
+		base = p;
+		if (const char *sn = getenv("MACTRACE_SNAP")) {     // "addr=name,addr=name"
+			std::string all(sn);
+			size_t pos = 0;
+			while (pos < all.size()) {
+				size_t e = all.find(',', pos); if (e == std::string::npos) e = all.size();
+				std::string it = all.substr(pos, e - pos);
+				size_t eq = it.find('=');
+				if (eq != std::string::npos)
+					snaps.emplace_back(uint32_t(strtoul(it.substr(0, eq).c_str(), nullptr, 16)) & 0xffffff, it.substr(eq + 1));
+				pos = e + 1;
+			}
+		}
+		fprintf(f, "# clock\t%u\n", clk);
+		enabled = 1;
+		return true;
+	}
+	static uint32_t key(uint32_t pc) {
+		uint32_t top = pc >> 24, a24 = pc & 0xffffff;
+		uint32_t reg = (top >= 0xf0) ? (top & 0xf) + 1 : 0;
+		return (reg << 24) | a24;
+	}
+	static bool is_rom(uint32_t pc) {
+		uint32_t top = pc >> 24;
+		return (pc & 0x00f00000) == 0x00800000 && top < 0xf0 && top != 0x50;
+	}
+	inline const char *pc_hook(const void *who, uint32_t pc, uint64_t cyc) {
+		if (who != owner) return nullptr;
+		icount++;
+		uint32_t k = key(pc);
+		uint8_t &b = hit[k >> 3];
+		uint8_t m = 1 << (k & 7);
+		if (!(b & m)) {
+			b |= m;
+			fprintf(f, "%c\t%08x\t%08x\t%llu\t%llu\n", is_rom(pc) ? 'R' : 'M', pc, lastpc,
+					(unsigned long long)icount, (unsigned long long)cyc);
+			lastpc = pc;
+			for (auto &sp : snaps)
+				if (sp.first == (pc & 0xffffff)) {
+					fprintf(f, "S\t%08x\t%s\t%llu\t%llu\n", pc, sp.second.c_str(), (unsigned long long)icount, (unsigned long long)cyc);
+					return sp.second.c_str();
+				}
+			return nullptr;
+		}
+		lastpc = pc;
+		return nullptr;
+	}
+	template <typename F> void dump(const char *name, F rd) {
+		std::string fn = base + ".lowmem-" + name + ".bin";
+		FILE *o = fopen(fn.c_str(), "wb");
+		if (!o) return;
+		for (uint32_t a = 0; a < 0x3000; a++) { uint8_t v = rd(a); fwrite(&v, 1, 1, o); }
+		fclose(o);
+	}
+	inline void trap_hook(const void *who, uint32_t pc, uint16_t ir, uint64_t cyc) {
+		if (who != owner) return;
+		uint32_t &c = trapcnt[ir & 0xfff];
+		if (trapseq < trapmax || c == 0)
+			fprintf(f, "A\t%08x\t%04x\t%llu\t%llu\n", pc, ir, (unsigned long long)icount, (unsigned long long)cyc);
+		c++; trapseq++;
+	}
+	inline void be_hook(const void *who, uint32_t pc, uint32_t addr, uint64_t cyc) {
+		if (who != owner) return;
+		if (becount++ < 5000)
+			fprintf(f, "B\t%08x\t%08x\t%llu\t%llu\n", pc, addr, (unsigned long long)icount, (unsigned long long)cyc);
+	}
+};
+mactrace_t g_mactrace;
+}
+#define MACTRACE_ON() (g_mactrace.enabled == 1 || (g_mactrace.enabled < 0 && g_mactrace.init(this, clock())))
