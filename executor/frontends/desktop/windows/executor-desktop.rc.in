// executor-desktop.exe's resources on Windows: the manifest, the icon and
// the version (git describe: @EXECUTOR_VERSION@)
#include <winver.h>

1 24 "@CMAKE_CURRENT_SOURCE_DIR@/windows/executor-desktop.manifest"
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/windows/executor.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MacPhoenix"
            VALUE "FileDescription", "Executor (MacPhoenix)"
            VALUE "FileVersion", "@EXECUTOR_VERSION@"
            VALUE "ProductName", "Executor"
            VALUE "ProductVersion", "@EXECUTOR_VERSION@"
            VALUE "OriginalFilename", "executor-desktop.exe"
            VALUE "LegalCopyright", "MIT / GPL-2.0-or-later (see LICENSING.md)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
