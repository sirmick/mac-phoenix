{
  "_": "settings.schema.json's checks, the same in tools/standalone (go test) and web/executor/settings.js (tab_settings.mjs). Each case: start (a patch to the defaults first), patch, then error (the path refused) or expect (dotted path -> value after).",
  "patches": [
    { "patch": { "machine": { "ram_mb": 128, "screen": "800x600" } }, "expect": { "machine.ram_mb": 128, "machine.screen": "800x600" } },
    { "patch": { "machine": { "ram_mb": 9999 } }, "error": "machine.ram_mb" },
    { "patch": { "machine": { "ram_mb": -1 } }, "error": "machine.ram_mb" },
    { "patch": { "machine": { "screen": "640 by 480" } }, "error": "machine.screen" },
    { "patch": { "machine": { "depth": 3 } }, "error": "machine.depth" },
    { "patch": { "machine": { "depth": 8 } }, "expect": { "machine.depth": 8 } },
    { "patch": { "machine": { "ppc": "yes" } }, "error": "machine.ppc" },
    { "patch": { "machine": { "nope": 1 } }, "error": "machine.nope" },
    { "patch": { "nope": {} }, "error": "nope" },
    { "patch": { "machine": 5 }, "error": "machine" },
    { "patch": { "input": { "command_key": "super" } }, "error": "input.command_key" },
    { "patch": { "input": { "command_key": "ctrl" } }, "expect": { "input.command_key": "ctrl", "input.right_click": "control" } },
    { "patch": { "sound": { "volume": 50.5 } }, "error": "sound.volume" },
    { "patch": { "sound": { "volume": 101 } }, "error": "sound.volume" },
    { "patch": { "disks": { "mounted": ["disks/a.img", ""] } }, "error": "disks.mounted[1]" },
    { "patch": { "disks": { "mounted": ["disks/a.img", "disks/b.img"] } }, "expect": { "disks.mounted": ["disks/a.img", "disks/b.img"] } },
    { "patch": { "network": { "relay_ports": [80, "1000-2000"] } }, "expect": { "network.relay_ports": [80, "1000-2000"] } },
    { "patch": { "network": { "relay_ports": ["2000-1000"] } }, "error": "network.relay_ports" },
    { "patch": { "network": { "relay_ports": [70000] } }, "error": "network.relay_ports[0]" },
    { "patch": { "network": { "secure_cookies": true } }, "expect": { "network.secure_cookies": true } },
    { "patch": { "network": { "secure_cookies": "maybe" } }, "error": "network.secure_cookies" },
    { "patch": { "network": { "port": 65536 } }, "error": "network.port" },
    { "patch": { "advanced": { "data": "/elsewhere" } }, "error": "advanced.data" },
    { "patch": { "network": { "password": true } }, "error": "network.password" },
    { "start": { "machine": { "ram_mb": 128, "ppc": true } }, "patch": { "machine": { "ram_mb": null } },
      "expect": { "machine.ram_mb": 0, "machine.ppc": true } },
    { "start": { "machine": { "ram_mb": 128, "ppc": true }, "sound": { "volume": 10 } }, "patch": { "machine": null },
      "expect": { "machine.ram_mb": 0, "machine.ppc": false, "sound.volume": 10 } },
    { "start": { "advanced": { "debug": "memcheck" } }, "patch": { "advanced": null }, "expect": { "advanced.debug": "" } },
    { "patch": { "version": 1, "display": { "scale": 2 } }, "expect": { "version": 2, "display.scale": 2 } }
  ],
  "migrations": [
    { "v1": { "bind": "0.0.0.0", "port": 9000, "images": "/srv/images", "include": ["*.img", "*.dsk"],
              "relay": { "enabled": false, "ports": [80], "max_sockets": 8 }, "max_upload_mb": 10 },
      "expect": { "version": 2, "network.bind": "0.0.0.0", "network.port": 9000, "disks.images": "/srv/images",
                  "disks.include": ["*.img", "*.dsk"], "network.relay_enabled": false, "network.relay_ports": [80],
                  "network.relay_max_sockets": 8, "network.relay_max_connections": 4, "network.max_upload_mb": 10,
                  "machine.screen": "640x480" } },
    { "v1": { "bind": "127.0.0.1", "colour": "red" }, "error": "colour" },
    { "v1": { "version": 3 }, "error": "version" }
  ]
}
