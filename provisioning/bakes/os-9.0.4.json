    "text": "Select Destination"
   },
   "max": 5
  },
  {
   "popup": {
    "text": "{boot}"
   },
   "choose": "{target}",
   "until": {
    "text": "None Installed",
    "exact": true,
    "front": true
   },
   "max": 5
  },
  {
   "shot": "1-destination"
  },
  {
   "click": {
    "button": "Select"
   },
