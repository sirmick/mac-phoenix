{
 "note": "MacPerl 5.2.0r4, Installer VISE Lite: Custom Install > Fat Binary + Shared Libraries onto the target (Switch Disk), by name and drawn text, each option checked by the disk space needed",
 "kind": "install",
 "media": [
  {
   "file": "Mac_Perl_520r4_appl.sit",
   "take": "Mac_Perl_520r4_appl",
   "as": "MacPerl Installer"
  }
 ],
 "expect": [
  "MacPerl ƒ"
 ],
 "launch": [
  "MacPerl ƒ:MacPerl"
 ],
 "os": "tools-7.6.1",
 "steps": [
  {
   "launch": "{media}:MacPerl Installer"
  },
  {
   "wait_for": {
    "button": "Continue"
   },
   "timeout": 60
  },
  {
   "click": {
    "button": "Continue"
   },
   "until": {
    "button": "Install",
    "exact": true
   },
   "max": 10
  },
  {
   "popup": {
    "text": "Easy Install"
   },
   "choose": "Custom Install"
  },
  {
   "click": {
    "text": "Fat Binary",
    "front": true
   }
  },
  {
   "check": {
    "text": "Approximate disk space needed: 10,352K"
   }
  },
  {
   "click": {
    "text": "Shared Libraries",
    "front": true
   }
  },
  {
   "check": {
    "text": "Approximate disk space needed: 10,428K"
   }
  },
  {
   "click": {
    "button": "Switch Disk"
   },
   "until": {
    "text": "on the disk “{target}”",
    "exact": true,
    "front": true
   },
   "max": 8
  },
  {
   "click": {
    "button": "Install",
    "exact": true
   }
  },
  {
   "wait_for": {
    "text": "The software was successfully installed."
   },
   "timeout": 300
  },
  {
   "click": {
    "button": "Quit"
   }
  }
 ]
}
