{
 "note": "Frontier 5.0.1, expanded by StuffIt Expander in the guest, then a first launch that answers its questions by name (personalize: OK with the defaults; read the licence now: No) and quits, so Frontier.root is set up",
 "kind": "expand",
 "archive": "Frontier_5.0.1.sit",
 "expect": [
  "Frontier 5.0.1"
 ],
 "launch": [
  "Frontier 5.0.1:UserLand Frontier™"
 ],
 "os": "tools-7.6.1",
 "steps": [
  {
   "launch": "{target}:Frontier 5.0.1:UserLand Frontier™"
  },
  {
   "click": {
    "button": "OK"
   },
   "until": {
    "button": "No"
   },
   "max": 10
  },
  {
   "click": {
    "button": "No"
   },
   "until": {
    "text": "Kind",
    "exact": true,
    "front": true
   },
   "max": 10
  },
  {
   "quit": true
  },
  {
   "wait_app_not": "UserLand Frontier",
   "timeout": 60
  }
 ],
 "volatile": [
  "Frontier 5.0.1:Frontier.root"
 ]
}
