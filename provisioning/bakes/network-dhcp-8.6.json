{
 "note": "As network-dhcp, for Mac OS 8.6 (PowerPC): the same control panel dialogs",
 "kind": "install",
 "os": "tools-8.6",
 "network": "socket",
 "system_take": [
  "Preferences:TCP/IP Preferences"
 ],
 "steps": [
  {
   "launch": "{system}Control Panels:TCP/IP"
  },
  {
   "wait_for": {
    "button": "Yes"
   },
   "timeout": 60
  },
  {
   "click": {
    "button": "Yes"
   },
   "until": {
    "text": "Using DHCP Server",
    "front": true
   },
   "max": 10
  },
  {
   "shot": "1-tcpip"
  },
  {
   "cmd_key": 12
  },
  {
   "wait_for": {
    "button": "Save"
   },
   "timeout": 30
  },
  {
   "click": {
    "button": "Save"
   }
  },
  {
   "wait_app_not": "TCP/IP",
   "timeout": 30
  }
 ]
}
