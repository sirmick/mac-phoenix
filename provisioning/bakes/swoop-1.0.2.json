{
 "note": "Swoop 1.0.2 (Ambrosia, 1995), its Installer VISE installer run in the guest (Install Location set to the target, Easy Install), its Installer VISE installer run in the guest (Install Location set to the target, Easy Install)",
 "kind": "install",
 "os": "tools-7.6.1",
 "media": [
  {
   "file": "Swoop_1.0.2_Installer.bin",
   "take": "Swoop Installer"
  }
 ],
 "expect": [],
 "steps": [
  {
   "launch": "{media}:Swoop Installer"
  },
  {
   "wait_for": {
    "text": "Install Location:"
   },
   "timeout": 90
  },
  {
   "popup": {
    "text": "{boot}",
    "front": true
   },
   "choose": "{target}",
   "until": {
    "text": "{target}",
    "exact": true,
    "front": true
   },
   "max": 5
  },
  {
   "click": {
    "button": "Install",
    "exact": true
   }
  },
  {
   "wait_for": {
    "text": "Installation was successful"
   },
   "timeout": 900
  },
  {
   "click": {
    "button": "Quit"
   }
  }
 ],
 "target": "Games"
}
