{
 "note": "HyperCard 2.4.1, Apple's Mac OS Install from the CD image: HyperCard only (AppleScript 1.1.1, Speech 1.5 and QuickTime 3.0 unticked by name), onto the System disk",
 "kind": "install",
 "disks": [
  {
   "file": "HyperCard241.img_.sit",
   "take": "HyperCard241.img"
  }
 ],
 "from_boot": true,
 "expect": [
  "HyperCard 2.4"
 ],
 "launch": [
  "HyperCard 2.4:HyperCard"
 ],
 "os": "tools-7.6.1",
 "steps": [
  {
   "launch": "HyperCard:Mac OS Install"
  },
  {
   "agent_exit": true
  },
  {
   "wait_for": {
    "button": "Continue"
   },
   "timeout": 90
  },
  {
   "click": {
    "button": "Continue"
   },
   "until": {
    "button": "Agree"
   },
   "max": 8
  },
  {
   "click": {
    "button": "Agree"
   },
   "until": {
    "button": "Select"
   },
   "max": 5
  },
  {
   "click": {
    "button": "Select"
   },
   "until": {
    "button": "Start"
   },
   "max": 5
  },
  {
   "click": {
    "button": "AppleScript 1.1.1"
   }
  },
  {
   "check": {
    "button": "AppleScript 1.1.1",
    "value": 0
   }
  },
  {
   "click": {
    "button": "English Text-To-Speech 1.5"
   }
  },
  {
   "check": {
    "button": "English Text-To-Speech 1.5",
    "value": 0
   }
  },
  {
   "click": {
    "button": "QuickTime™ 3.0"
   }
  },
  {
   "check": {
    "button": "QuickTime™ 3.0",
    "value": 0
   }
  },
  {
   "check": {
    "button": "HyperCard 2.4.1",
    "value": 1
   }
  },
  {
   "click": {
    "button": "Start"
   }
  },
  {
   "wait_for": {
    "button": "Quit"
   },
   "timeout": 600
  },
  {
   "click": {
    "button": "Quit"
   }
  },
  {
   "reboot": true
  }
 ]
}
