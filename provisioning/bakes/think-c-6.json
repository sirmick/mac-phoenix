{
 "note": "THINK C 6.0: its four floppies through Disk Copy, Apple's Installer 3.4.3 (Easy Install onto the target), by name; it installs into a folder named Development",
 "kind": "install",
 "media": [
  {
   "file": "Think_C-6.sit",
   "take": "Symantec Think C V6.0",
   "as": "THINK C 6"
  }
 ],
 "expect": [
  "Development"
 ],
 "launch": [
  "Development:THINK C:THINK Project Manager"
 ],
 "os": "tools-7.6.1",
 "steps": [
  {
   "open": "{media}:THINK C 6:disk 1.img"
  },
  {
   "open": "{media}:THINK C 6:disk 2.img"
  },
  {
   "open": "{media}:THINK C 6:disk 3.img"
  },
  {
   "open": "{media}:THINK C 6:disk 4.img"
  },
  {
   "wait_for": {
    "text": "disk 4",
    "exact": true
   },
   "timeout": 60
  },
  {
   "launch": "disk 1:Launch me to install"
  },
  {
   "agent_exit": true
  },
  {
   "click": {
    "button": "OK"
   },
   "until": {
    "button": "Switch Disk"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Switch Disk"
   },
   "until": {
    "text": "{target}",
    "exact": true,
    "front": true,
    "outside_controls": true
   },
   "max": 8
  },
  {
   "click": {
    "button": "Install",
    "exact": true
   }
  },
  {
   "wait_for": {
    "text": "Installation",
    "front": true
   },
   "timeout": 600
  },
  {
   "click": {
    "button": "Quit"
   }
  },
  {
   "reboot": true
  }
 ]
}
