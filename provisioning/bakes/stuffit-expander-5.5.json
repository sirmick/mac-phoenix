{
 "note": "StuffIt Expander 5.5, StuffIt InstallerMaker: Easy Install; the Standard File dialog is driven by name (Desktop until the target is listed, the target's entry double-clicked); made the default helper application",
 "kind": "install",
 "media": [
  {
   "file": "stuffit_expander_5.5.bin",
   "take": "Aladdin Expander™ 5.5 Installer",
   "as": "StuffIt Expander Installer"
  }
 ],
 "expect": [
  "StuffIt Expander™ 5.5"
 ],
 "launch": [
  "StuffIt Expander™ 5.5:StuffIt Expander™"
 ],
 "os": "os-7.6.1",
 "steps": [
  {
   "launch": "{media}:StuffIt Expander Installer"
  },
  {
   "click": {
    "button": "Continue"
   },
   "until": {
    "button": "Print…"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Continue"
   },
   "until": {
    "button": "Agree"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Agree"
   },
   "until": {
    "text": "Easy Install"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Install"
   },
   "until": {
    "button": "Desktop"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Desktop"
   },
   "until": {
    "text": "{target}",
    "exact": true,
    "outside_controls": true,
    "front": true
   },
   "max": 10
  },
  {
   "dclick": {
    "text": "{target}",
    "exact": true,
    "outside_controls": true,
    "front": true
   }
  },
  {
   "click": {
    "button": "Install"
   }
  },
  {
   "wait_for": {
    "button": "OK"
   },
   "timeout": 120
  },
  {
   "click": {
    "button": "OK"
   }
  },
  {
   "wait_for": {
    "button": "Quit"
   },
   "timeout": 60
  },
  {
   "click": {
    "button": "Quit"
   }
  }
 ]
}
