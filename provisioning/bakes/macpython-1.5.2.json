{
 "note": "MacPython 1.5.2, Installer VISE Easy Install onto the target (Switch Disk), by name and drawn text. It installs the PythonCore for the machine it runs on: run on both, the merge makes one fat PythonCore (and keeps the PPC run's Numerical extension).",
 "kind": "install",
 "media": [
  {
   "file": "MacPython152.bin",
   "take": "Python 1.5.2 Installer"
  }
 ],
 "expect": [
  "Python 1.5.2c1"
 ],
 "launch": [
  "Python 1.5.2c1:PythonInterpreter"
 ],
 "steps": [
  {
   "launch": "{media}:Python 1.5.2 Installer"
  },
  {
   "wait_for": {
    "button": "Continue"
   },
   "timeout": 90
  },
  {
   "shot": "1-readme"
  },
  {
   "click": {
    "button": "Continue"
   },
   "until": {
    "button": "Install",
    "exact": true
   },
   "max": 10
  },
  {
   "click": {
    "button": "Switch Disk"
   },
   "until": {
    "text": "on the disk “{target}”",
    "exact": true,
    "front": true
   },
   "max": 8
  },
  {
   "shot": "2-options"
  },
  {
   "click": {
    "button": "Install",
    "exact": true
   }
  },
  {
   "wait_for": {
    "text": "The software was successfully installed."
   },
   "timeout": 600
  },
  {
   "shot": "3-done"
  },
  {
   "click": {
    "button": "Quit"
   }
  }
 ],
 "machines": [
  "68k",
  "ppc"
 ],
 "os": "tools-7.6.1",
 "prefer": {
  "Preferences:Python:Python 1.5.2c1 Preferences": 0
 },
 "volatile": [
  "Preferences:Python:Python 1.5.2c1 Preferences"
 ]
}
