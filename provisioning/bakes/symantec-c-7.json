{
 "note": "Symantec C++ 7: its floppies (raw, converted to Disk Copy 4.2) through Disk Copy, Apple's Installer (Easy Install onto the target), by name; it installs into a folder named Development",
 "kind": "install",
 "media": [
  {
   "file": "symantec_c_7.sit",
   "take": "Symantec C++ 7",
   "as": "Symantec C++ 7",
   "dc42": true
  }
 ],
 "expect": [
  "Development"
 ],
 "launch": [
  "Development:Symantec C++ for Macintosh:THINK Project Manager"
 ],
 "steps": [
  {
   "open": "{media}:Symantec C++ 7:Disk 1.dsk"
  },
  {
   "open": "{media}:Symantec C++ 7:Disk 2.dsk"
  },
  {
   "open": "{media}:Symantec C++ 7:Disk 3.dsk"
  },
  {
   "open": "{media}:Symantec C++ 7:Disk 4.dsk"
  },
  {
   "open": "{media}:Symantec C++ 7:Disk 5.dsk"
  },
  {
   "open": "{media}:Symantec C++ 7:AppleScript Setup.dsk"
  },
  {
   "wait": 5
  },
  {
   "launch": "Disk 1:Installer"
  },
  {
   "click": {
    "button": "OK"
   },
   "until": {
    "button": "Switch Disk"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Switch Disk"
   },
   "until": {
    "text": "{target}",
    "exact": true,
    "front": true,
    "outside_controls": true
   },
   "max": 8
  },
  {
   "shot": "1-target"
  },
  {
   "click": {
    "button": "Install",
    "exact": true
   }
  },
  {
   "wait_for": {
    "text": "Installation",
    "front": true
   },
   "timeout": 900
  },
  {
   "shot": "2-done"
  },
  {
   "click": {
    "button": "Quit"
   }
  }
 ],
 "os": "tools-7.6.1"
}
