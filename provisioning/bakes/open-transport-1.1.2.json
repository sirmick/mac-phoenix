{
 "note": "Open Transport 1.1.2 (Legacy CD floppies, attached as disks) for System 7.5.5, on the bare os-7.5.5 (it's part of tools-7.5.5): Custom Install, both 'for 68K Macintoshes' and 'for all Macintoshes', onto the startup disk, then its restart. Easy Install ('all Macintoshes' only) leaves System 7.5.3's 1.1 68K libraries: on the 68k machine OT then doesn't load, on the PPC machine 7.5.5 bombs at startup (illegal instruction). 7.6.1 has Open Transport built in. It patches the System file and replaces MacTCP DNR and AppleTalk Preferences with its own (without that one OT doesn't load), so those are taken too (system_take): the snapshot is for os-7.5.5 only.",
 "kind": "install",
 "os": "os-7.5.5",
 "steps": [
  {
   "launch": "Install 1:Installer"
  },
  {
   "wait_for": {
    "button": "Continue…"
   },
   "timeout": 90
  },
  {
   "agent_exit": true
  },
  {
   "click": {
    "button": "Continue…"
   },
   "until": {
    "button": "Switch Disk"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Switch Disk"
   },
   "until": {
    "text": "{boot}",
    "exact": true,
    "front": true
   },
   "max": 8
  },
  {
   "popup": {
    "text": "Easy Install"
   },
   "choose": "Custom Install"
  },
  {
   "wait_for": {
    "text": "Open Transport for 68K Macintoshes"
   },
   "timeout": 30
  },
  {
   "click": {
    "text": "Open Transport for 68K Macintoshes",
    "front": true
   }
  },
  {
   "check": {
    "text": "Selected size: 1,933K"
   }
  },
  {
   "click": {
    "text": "Open Transport for all Macintoshes",
    "front": true
   }
  },
  {
   "check": {
    "text": "Selected size: 4,302K"
   }
  },
  {
   "shot": "1-custom"
  },
  {
   "click": {
    "button": "Install"
   }
  },
  {
   "wait_for": {
    "text": "Installation was successful",
    "front": true
   },
   "timeout": 600
  },
  {
   "shot": "2-installed"
  },
  {
   "click": {
    "button": "Restart"
   }
  },
  {
   "wait_finder": 240
  }
 ],
 "disks": [
  {
   "file": "Apple Legacy Recovery.iso",
   "take": ":Apple SW (N-Z):Open Transport 1.1.2:Install 1.img"
  },
  {
   "file": "Apple Legacy Recovery.iso",
   "take": ":Apple SW (N-Z):Open Transport 1.1.2:Install 2.img"
  },
  {
   "file": "Apple Legacy Recovery.iso",
   "take": ":Apple SW (N-Z):Open Transport 1.1.2:Install 3.img"
  },
  {
   "file": "Apple Legacy Recovery.iso",
   "take": ":Apple SW (N-Z):Open Transport 1.1.2:Install 4.img"
  }
 ],
 "system_take": [
  "System",
  "MacTCP DNR",
  "Preferences:AppleTalk Preferences"
 ]
}
