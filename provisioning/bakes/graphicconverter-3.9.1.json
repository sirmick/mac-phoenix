{
 "note": "GraphicConverter 3.9.1 (Thorsten Lemke, 1999; shareware): the 68k and PowerPC builds, each off its self-mounting image, copied by the guest",
 "kind": "copy",
 "os": "tools-7.6.1",
 "disks": [
  {
   "file": "graphicconverter_3.91_68k.sit",
   "take": "GraphicConverter 3.9.1US 68.smi"
