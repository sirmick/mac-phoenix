{
 "note": "StuffIt Expander 6.0.1 (Aladdin, 2001) for Mac OS 8.6 and 9: its InstallerMaker installer, Easy Install into the target (the Standard File dialog by name, as 5.5's); it installs CarbonLib in the System Folder too; no desktop alias; made the default helper application",
 "kind": "install",
 "os": "os-8.6",
 "media": [
  {
   "file": "Aladdin_Expander_6.0.1.sea_.bin",
   "take": "Install Aladdin Expander 6.0.1"
  }
 ],
 "steps": [
  {
   "launch": "{media}:Install Aladdin Expander 6.0.1"
  },
  {
   "click": {
    "button": "Continue"
   },
   "until": {
    "button": "Print…"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Continue"
   },
   "until": {
    "button": "Agree"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Agree"
   },
   "until": {
    "text": "Easy Install"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Install"
   },
   "until": {
    "button": "Desktop"
   },
   "max": 10
  },
  {
   "click": {
    "button": "Desktop"
   },
   "until": {
    "text": "{target}",
    "exact": true,
    "outside_controls": true,
    "front": true
   },
   "max": 10
  },
  {
   "dclick": {
    "text": "{target}",
    "exact": true,
    "outside_controls": true,
    "front": true
   }
  },
  {
   "click": {
    "button": "Install"
   },
   "until": {
    "button": "Yes"
   },
   "max": 5
  },
  {
   "click": {
    "button": "Yes"
   }
  },
  {
   "wait_for": {
    "text": "Do you wish to create an alias for StuffIt"
   },
   "timeout": 300
  },
  {
   "click": {
    "button": "No"
   }
  },
  {
   "wait_for": {
    "text": "default helper"
   },
   "timeout": 60
  },
  {
   "click": {
    "button": "OK"
   }
  },
  {
   "wait_for": {
    "text": "Installation was successful."
   },
   "timeout": 120
  },
  {
   "click": {
    "button": "Quit"
   }
  }
 ]
}
