{
 "note": "Disk Copy 6.3.3 off its self-mounting image, copied by the guest; first launch accepts the licence (its preferences are captured)",
 "kind": "copy",
 "disks": [
  {
   "file": "Disk-Copy-633-smi.bin"
  }
 ],
 "expect": [
  "Disk Copy"
 ],
 "launch": [
  "Disk Copy:Disk Copy"
 ],
 "steps": [
  {
   "copy": {
    "from": "Disk Copy:",
    "to": "{target}:"
   }
  },
  {
   "launch": "{target}:Disk Copy:Disk Copy"
  },
  {
   "wait_for": {
    "button": "Agree"
   },
   "timeout": 60
  },
  {
   "shot": "1-licence"
  },
  {
   "click": {
    "button": "Agree"
   }
  },
  {
   "wait_app": "Disk Copy",
   "timeout": 30
  },
  {
   "shot": "2-agreed"
  },
  {
   "quit": true
  },
  {
   "wait_app_not": "Disk Copy",
   "timeout": 30
  }
 ],
 "os": "os-7.6.1"
}
